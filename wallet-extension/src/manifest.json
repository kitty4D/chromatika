{
  "manifest_version": 3,
  "key": "",
  "name": "Chromatika",
  "version": "0.1.1",
  "description": "Multi-chain wallet with Ika dWallets",
  "action": {
    "default_title": "Chromatika",
    "default_popup": "index.html",
    "default_icon": {
      "16": "chromatika-logo-16.png",
      "32": "chromatika-logo-32.png",
      "48": "chromatika-logo-48.png",
      "128": "chromatika-logo-128.png"
    }
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-script/index.ts"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/dapp-interface/inject.ts"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; object-src 'none'; connect-src * data:; font-src 'self' https://fonts.gstatic.com; img-src * data:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; frame-src https://connect.trezor.io https://verify.walletconnect.org https://verify.walletconnect.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none';"
  },
  "permissions": [
    "storage",
    "idle",
    "tabs",
    "alarms",
    "unlimitedStorage",
    "webRequest",
    "sidePanel",
    "declarativeNetRequest",
    "downloads",
    "nativeMessaging",
    "notifications",
    "offscreen"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "chromatika-logo-16.png",
    "32": "chromatika-logo-32.png",
    "48": "chromatika-logo-48.png",
    "128": "chromatika-logo-128.png"
  }
}
