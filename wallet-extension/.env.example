# Copy to `.env` and fill in. VITE_* values are inlined at **build** time — rebuild after changes.
# Do not commit real secrets; `.env` should stay local / CI-only.

# --- Third-party API keys (optional) ---

# WalletConnect Project ID — required to surface the WalletConnect option on the hardware
# step. Without it, the WC button stays disabled with a "register a project at cloud.reown.com"
# hint. WC is the canonical Solana hardware path on desktop now that Solana Mobile's reflector
# demo is unreliable; on Android, both MWA local intent and WC are surfaced (WC covers wallets
# that ship WC instead of MWA, e.g. Jupiter Mobile).
# VITE_WC_PROJECT_ID=

# EVM NFT metadata (Alchemy NFT API). Without it, EVM collectibles stay empty in the NFT tab.
# VITE_ALCHEMY_KEY=

# Helius API key: Solana NFTs (DAS) and built-in Solana mainnet/devnet JSON-RPC presets (balances, sends).
# Without it, mainnet preset falls back to Ankr public RPC; devnet uses Solana Labs devnet.
# VITE_HELIUS_KEY=

# CoinMarketCap Pro — extra step in the price waterfall after DefiLlama (`services/price.ts`).
# VITE_CMC_API_KEY=

# --- Feature flags (string booleans; unset = defaults below) ---

# Aftermath Sui → IKA swap UI (`features.ts`). Default: enabled. Set to `false` to turn off.
# VITE_PHASE_B_SUI_SWAP=true

# Show Solana as ika base in **production** builds. Dev builds always show it. Set `true` to enable in prod.
# VITE_SOLANA_IKA_BASE=false

# Re-enable the legacy MWA-remote (Seeker QR pair) hardware option on desktop. Solana Mobile's
# reflector demo is currently unreliable for everyone (reflector bug surface affects all MWA
# wallets that try to use it), so the button is hidden by default. Flip to `true` after
# Solana Mobile fixes the reflector — the code path stays in place behind this flag.
# VITE_ENABLE_MWA_REMOTE=false

# --- Debug (optional) ---

# Verbose Sui GraphQL logging in the service worker console (`sui-graphql-debug-fetch.ts`).
# VITE_DEBUG_GRAPHQL=false

# When debug is on, optional comma allowlist so the console is not flooded (case-insensitive).
# Example ika sign polling: multiGetObjects (and getObject if your build names it). Add _anon_ for requests we could not infer.
# VITE_DEBUG_GRAPHQL_OPS=multiGetObjects,getObject,_anon_

# Extra pagination logging for GraphQL (noisy). Implies more console detail when combined with dev or VITE_DEBUG_GRAPHQL.
# VITE_DEBUG_GRAPHQL_PAGINATION=false

# --- Node-only (vite / scripts; not import.meta.env) ---

# `pnpm run dev:launch` sets this. Auto-open Chromium when using vite-plugin-web-extension watch.
# CHROMATIKA_WEBEXT_LAUNCH=1

# `pnpm run dev:polling` — file watching over flaky FS (e.g. some Docker/VM mounts).
# CHOKIDAR_USEPOLLING=1
