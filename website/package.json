{
  "name": "chromatika-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/write-library-manifest.mjs && node scripts/ensure-rich-guide-images.mjs && node scripts/sync-wallet-preview.mjs && vite",
    "build": "node scripts/write-library-manifest.mjs && node scripts/ensure-rich-guide-images.mjs && node scripts/sync-wallet-preview.mjs --build && tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"vite.config.ts\" --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run format:check",
    "sync:library": "node scripts/rewrite-library-md-links.mjs",
    "sync:wallet-preview": "node scripts/sync-wallet-preview.mjs --build",
    "generate:og": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "framer-motion": "12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^5.4.19"
  }
}
